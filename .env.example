# Copia questo file in ".env" (gia' escluso da .gitignore) e compila i valori.
# Progetto separato da JobInPA: nessun DB, nessun utente e nessun segreto
# condiviso con l'altro repo — solo la connessione via API private qui sotto.

APP_ENV=development
# https:// richiesto per l'autorizzazione OAuth di Instagram (Instagram
# Business Login non accetta http://localhost). Genera un certificato
# locale fidato con mkcert prima del primo avvio:
#   mkcert -install
#   mkcert -cert-file certs/localhost.pem -key-file certs/localhost-key.pem localhost 127.0.0.1 ::1
APP_BASE_URL=https://localhost:8100
# Percorsi ASSOLUTI, non relativi: app/worker/scheduler girano in container
# diversi con working_dir diversi (/app e /app/src), quindi un percorso
# relativo si risolverebbe in posti diversi a seconda del servizio — bug
# reale gia' incontrato (il worker apriva un DB vuoto in /app/src/data/).
# Lascia vuoto per usare il default assoluto gia' corretto nel codice
# (db_social.DB_PATH / config.asset_storage_path()); valorizza solo per
# puntare altrove, sempre con un percorso assoluto.
SOCIAL_DB_PATH=
ASSET_STORAGE_PATH=/app/assets/generated
DEFAULT_TIMEZONE=Europe/Rome
LOG_LEVEL=INFO

# Firma i token di sessione/CSRF. Genera con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SOCIAL_AUTH_SECRET=

# Cifra i token OAuth (Instagram/LinkedIn). Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Modalita' operativa: mock | sandbox (default, AI reale ma publisher sempre
# simulato) | production. Kill switch di livello environment: deve restare
# false finche' non si e' pronti a pubblicare davvero.
SOCIAL_MODE=sandbox
GLOBAL_PUBLISHING_ENABLED=false

# --- JobInPA — API private (bandi + classificazione AI) ----------------------
# Stessa API key configurata lato JobInPA in INTERNAL_API_KEY (.env della VM).
# In sviluppo locale, se anche JobInPA gira sulla stessa macchina:
#   JOBINPA_API_URL=http://localhost:8000
# In produzione:
#   JOBINPA_API_URL=https://jobinpa.it
JOBINPA_API_URL=
JOBINPA_API_KEY=

# --- Anthropic (testo e ragionamento) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_MONTHLY_BUDGET_EUR=20
ANTHROPIC_DAILY_BUDGET_EUR=3

# --- OpenAI Images (opzionale, default spento) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
ENABLE_AI_IMAGES=false
OPENAI_IMAGE_MONTHLY_BUDGET_EUR=5

# --- SMTP (email di approvazione) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JobInPA Social AI
SMTP_USE_TLS=true

# --- Instagram (Instagram API with Instagram Login) ---
# Flusso nativo Instagram: niente piu' Pagina Facebook di mezzo.
# INSTAGRAM_ACCOUNT_ID non serve: si ottiene dal token dopo l'autorizzazione.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8100/social/oauth/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v21.0

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8100/social/oauth/linkedin/callback
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_API_VERSION=202411
